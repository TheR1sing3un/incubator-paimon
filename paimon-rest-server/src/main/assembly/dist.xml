<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.0
                              http://maven.apache.org/xsd/assembly-2.1.0.xsd">
    <id>dist</id>
    <formats>
        <format>tar.gz</format>
    </formats>
    <includeBaseDirectory>true</includeBaseDirectory>
    <baseDirectory>paimon-rest-server-${project.version}</baseDirectory>

    <fileSets>
        <!-- lib/: project jar -->
        <fileSet>
            <directory>${project.build.directory}</directory>
            <outputDirectory>lib</outputDirectory>
            <includes>
                <include>${project.build.finalName}.jar</include>
            </includes>
        </fileSet>

        <!-- lib/: all runtime dependency jars -->
        <fileSet>
            <directory>${project.build.directory}/lib</directory>
            <outputDirectory>lib</outputDirectory>
            <includes>
                <include>*.jar</include>
            </includes>
        </fileSet>

        <!-- conf/: all config files -->
        <fileSet>
            <directory>${project.basedir}/deploy/conf</directory>
            <outputDirectory>conf</outputDirectory>
        </fileSet>

        <!-- bin/: all scripts -->
        <fileSet>
            <directory>${project.basedir}/deploy/bin</directory>
            <outputDirectory>bin</outputDirectory>
            <fileMode>0755</fileMode>
        </fileSet>

        <!-- sql/: init.sql -->
        <fileSet>
            <directory>${project.basedir}/src/main/resources</directory>
            <outputDirectory>sql</outputDirectory>
            <includes>
                <include>init.sql</include>
            </includes>
        </fileSet>
    </fileSets>
</assembly>
